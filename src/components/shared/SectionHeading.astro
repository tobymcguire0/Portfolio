---
interface Props {
  heading: string;
  link?: {
    label: string;
    href: string;
    external?: boolean;
    download?: boolean;
  };
}

const { heading, link } = Astro.props;
---

{
  link ? (
    <div class="sec-title">
      <h2 class="h2">{heading}</h2>
      <a
        class="small text-link"
        href={link.href}
        download={link.download ? '' : undefined}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener' : undefined}
      >
        {link.label}
        {link.external && <span class="sr-only"> (opens in a new tab)</span>}
      </a>
    </div>
  ) : (
    <h2 class="h2 sec-title">{heading}</h2>
  )
}
