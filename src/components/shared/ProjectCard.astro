---
interface Props {
  title: string;
  description: string;
  stack: string[];
  github?: string;
  live?: string;
  slug: string;
  image?: string;
  role?: string;
}

const { title, description, stack, github, live, slug, image, role } =
  Astro.props;
---

<article
  class="group rounded-xl border border-text-200 bg-background-50 p-6 hover:border-accent-300 hover:shadow-lg hover:bg-background-100 transition-all duration-200"
>
  {
    image && (
      <div class="mb-4 rounded-lg overflow-hidden bg-background-100 aspect-video">
        <img
          src={image}
          alt={`Screenshot of ${title}`}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    )
  }
  <h3
    class="text-xl font-semibold text-text group-hover:text-accent transition-colors"
  >
    <a href={`/projects/${slug}`} class="hover:underline">{title}</a>
  </h3>
  {role && <p class="text-sm text-text-500 mt-1">{role}</p>}
  <p class="mt-2 text-text-700 text-sm leading-relaxed">{description}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {
      stack.map((tech) => (
        <span class="inline-block px-2.5 py-0.5 text-xs font-medium bg-accent-100 text-accent-700 rounded-full">
          {tech}
        </span>
      ))
    }
  </div>
  <div class="mt-4 flex items-center gap-3">
    {
      github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-text-600 hover:text-accent transition-colors"
        >
          GitHub &rarr;
        </a>
      )
    }
    {
      live && (
        <a
          href={live}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-text-600 hover:text-accent transition-colors"
        >
          Live Demo &rarr;
        </a>
      )
    }
  </div>
</article>
