---
interface Props {
  href: string;
  title: string;
  label?: string;
  description: string;
  stack: string[];
  image?: string;
  /** Leave empty for decorative artwork. */
  imageAlt?: string;
}

const { href, title, description, stack, image, imageAlt = '' } = Astro.props;
---

<a class="proj" href={href}>
  <div class="proj-art">{image && <img src={image} alt={imageAlt} />}</div>
  <div class="proj-main">
    <h3 class="h3">{title}</h3>
    <p>{description}</p>
  </div>
  <div class="proj-side">
    <ul class="stackline">{stack.map((item) => <li>{item}</li>)}</ul>
    <span class="go">See More</span>
  </div>
</a>
