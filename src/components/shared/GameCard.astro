---
import ProjectCard from './ProjectCard.astro';

interface Props {
  slug: string;
  title: string;
  pitch: string;
  tags: string[];
  image?: string;
  imageAlt?: string;
}

const { slug, title, pitch, tags, image, imageAlt } = Astro.props;
---

<ProjectCard
  href={`/games/${slug}/`}
  title={title}
  description={pitch}
  stack={tags}
  image={image}
  imageAlt={imageAlt}
/>
