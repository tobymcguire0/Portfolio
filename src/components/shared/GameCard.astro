---
interface Props {
  title: string;
  pitch: string;
  genre: string;
  platform: string;
  itchUrl?: string;
  github?: string;
  slug: string;
  image?: string;
  tags?: string[];
}

const {
  title,
  pitch,
  genre,
  platform,
  itchUrl,
  github,
  slug,
  image,
  tags = [],
} = Astro.props;
---

<article
  class="group relative rounded-xl border border-surface-700 bg-gradient-to-b from-surface-800 to-surface-900 text-white overflow-hidden hover:shadow-xl hover:shadow-primary-500/10 transition-all duration-300"
>
  {
    image ? (
      <div class="aspect-video overflow-hidden">
        <img
          src={image}
          alt={`Screenshot of ${title}`}
          class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-300"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="aspect-video bg-gradient-to-br from-primary-600/20 to-primary-900/40 flex items-center justify-center">
        <span class="text-5xl opacity-30 select-none" aria-hidden="true">
          &#x1F3AE;
        </span>
      </div>
    )
  }
  <div class="p-5">
    <div class="flex items-center gap-2 mb-2">
      <span
        class="text-xs font-medium px-2 py-0.5 rounded-full bg-primary-500/20 text-primary-300"
        >{genre}</span
      >
      <span class="text-xs text-surface-400">{platform}</span>
    </div>
    <h3
      class="text-lg font-bold text-white group-hover:text-primary-300 transition-colors"
    >
      <a href={`/games/${slug}`} class="hover:underline">{title}</a>
    </h3>
    <p class="mt-2 text-surface-300 text-sm leading-relaxed">{pitch}</p>
    {
      tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="text-xs px-2 py-0.5 rounded bg-surface-700 text-surface-300">
              {tag}
            </span>
          ))}
        </div>
      )
    }
    <div class="mt-4 flex items-center gap-3">
      {
        itchUrl && (
          <a
            href={itchUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-primary-400 hover:text-primary-300 font-medium transition-colors"
          >
            Play on itch.io &rarr;
          </a>
        )
      }
      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-surface-400 hover:text-surface-200 transition-colors"
          >
            Source &rarr;
          </a>
        )
      }
    </div>
  </div>
</article>
