---
interface Props {
  title: string;
  pitch: string;
  genre: string;
  platform: string;
  itchUrl?: string;
  github?: string;
  steam?: string;
  slug: string;
  image?: string;
  tags?: string[];
}

const {
  title,
  pitch,
  genre,
  platform,
  itchUrl,
  github,
  steam,
  slug,
  image,
  tags = [],
} = Astro.props;
---

<article
  class="group relative rounded-xl border border-surface-700 bg-gradient-to-b from-surface-700 to-surface-950 hover:from-surface-500 hover:to-surface-950 text-white overflow-hidden hover:to-surface-800 hover:from-surface-550 hover:shadow-xl hover:shadow-accent-800/10 transition-all duration-300"
>
  {
    image ? (
      <div class="aspect-video overflow-hidden">
        <img
          src={image}
          alt={`Screenshot of ${title}`}
          class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-300"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="aspect-video bg-gradient-to-br from-accent-500/20 to-surface-950/80 flex items-center justify-center">
        <span class="text-5xl opacity-30 select-none" aria-hidden="true">
          &#x1F3AE;
        </span>
      </div>
    )
  }
  <div class="p-5">
    <div class="flex items-center gap-2 mb-2">
        <span
        class="text-xs font-medium px-2 py-0.5 rounded-full bg-accent-500/20 text-accent-100"
        >{genre}</span
      >
      <span class="text-xs text-surface-200">{platform}</span>
    </div>
    <h3
      class="text-lg font-bold text-white group-hover:text-accent-100 transition-colors"
    >
      <a href={`/games/${slug}`} class="hover:underline">{title}</a>
    </h3>
    <p class="mt-2 text-surface-100 text-sm leading-relaxed">{pitch}</p>
    {
      tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="text-xs px-2 py-0.5 rounded bg-surface-700 text-surface-100">
              {tag}
            </span>
          ))}
        </div>
      )
    }
    <div class="mt-4 flex items-center gap-3">
      {
        steam && (
          <a
            href={steam}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-accent-100 hover:text-white font-medium transition-colors"
          >
            View on Steam &rarr;
          </a>
        )
      }
      {
        itchUrl && (
          <a
            href={itchUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-accent-100 hover:text-white font-medium transition-colors"
          >
            Play on itch.io &rarr;
          </a>
        )
      }
      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-surface-200 hover:text-white transition-colors"
          >
            Source &rarr;
          </a>
        )
      }
      
    </div>
  </div>
</article>
