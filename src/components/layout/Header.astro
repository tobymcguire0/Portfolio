---
import { siteConfig, linkedinLink } from '../../data/site';
import type { NavLink } from '../../lib/case-studies';

export interface Props {
  /** In-page or cross-page links shown between the brand and the actions. */
  links?: NavLink[];
  /** href of the current page, marked with aria-current. */
  current?: string;
  github?: { href: string; label: string };
  showLinkedIn?: boolean;
}

const {
  links = [],
  current,
  github = { href: siteConfig.github, label: 'GitHub' },
  showLinkedIn = false,
} = Astro.props;
---

<header class="nav">
  <div class="wrap">
    <a class="brand" href="/"><img src={siteConfig.photo} alt="" />{siteConfig.name}</a>
    {
      links.length > 0 && (
        <nav class="nav-links" aria-label="Case studies">
          {links.map((link) => (
            <a href={link.href} aria-current={link.href === current ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
      )
    }
    <div class="nav-actions">
      <a
        class="icon-link"
        href={github.href}
        target="_blank"
        rel="noopener"
        aria-label={`${github.label} (opens in a new tab)`}
        ><svg viewBox="0 0 16 16"><use href="#i-gh"></use></svg></a
      >
      {
        showLinkedIn && (
          <a class="icon-link" {...linkedinLink} aria-label="LinkedIn">
            <svg viewBox="0 0 16 16"><use href="#i-in" /></svg>
          </a>
        )
      }
      <a class="btn btn-primary" href={siteConfig.resume} download
        ><svg viewBox="0 0 24 24"><use href="#i-dl"></use></svg><span class="btn-label">Resume</span></a
      >
    </div>
  </div>
</header>
