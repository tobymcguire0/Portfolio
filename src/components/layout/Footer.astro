---
import { siteConfig } from '../../data/site';

export interface Props {
  variant?: 'home' | 'case';
}

const { variant = 'case' } = Astro.props;
const host = new URL(siteConfig.url).host;
---

<footer class="foot">
  <div class="wrap">
    {
      variant === 'home' ? (
        <>
          <span class="small">&copy; {new Date().getFullYear()} {siteConfig.name} · {host}</span>
          <span class="cap mono">Hand-written HTML &amp; CSS</span>
        </>
      ) : (
        <>
          <a class="small" href="/">&larr; Back to portfolio</a>
          <span class="small">{siteConfig.email}</span>
        </>
      )
    }
  </div>
</footer>
