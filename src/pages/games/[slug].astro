---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

export async function getStaticPaths() {
  // Entries without a case study are only listed on the homepage.
  const games = await getCollection('games', ({ data }) => data.caseStudy !== undefined);
  return games.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { game } = Astro.props;
const { title, pitch, github, caseStudy } = game.data;
if (!caseStudy) throw new Error(`${game.id} has no caseStudy`);
const { Content } = await game.render();
---

<CaseStudyLayout
  href={`/games/${game.slug}/`}
  title={title}
  description={pitch}
  github={github}
  caseStudy={caseStudy}
>
  <Content />
</CaseStudyLayout>
