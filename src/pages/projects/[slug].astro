---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

export async function getStaticPaths() {
  // Entries without a case study are only listed on the homepage.
  const projects = await getCollection('projects', ({ data }) => data.caseStudy !== undefined);
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project } = Astro.props;
const { title, description, github, caseStudy } = project.data;
if (!caseStudy) throw new Error(`${project.id} has no caseStudy`);
const { Content } = await project.render();
---

<CaseStudyLayout
  href={`/projects/${project.slug}/`}
  title={title}
  description={description}
  github={github}
  caseStudy={caseStudy}
>
  <Content />
</CaseStudyLayout>
