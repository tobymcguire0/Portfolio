---
import BaseLayout from '../layouts/BaseLayout.astro';

const skillSections = [
  {
    title: 'Languages',
    items: ['C', 'C++', 'C#', 'Java', 'Python', 'TypeScript'],
  },
  {
    title: 'AI / ML',
    items: [
      'TensorFlow',
      'YoloV5',
      'NumPy',
      'PyTorch (learning)',
      'Computer Vision',
    ],
  },
  {
    title: 'Tools & Infra',
    items: ['AWS', 'Docker', 'Git', 'Linux', 'Blender', 'Unity'],
  },
  {
    title: 'Web',
    items: ['React', 'Node.js', 'TypeScript', 'Express', 'PostgreSQL'],
  },
  {
    title: 'Certifications',
    items: ['AWS Cloud Practitioner', 'Secret Security Clearance'],
  },
];

const keyProjects = [
  {
    title: 'Nauticus Robotics: Data Generation Pipeline',
    stack: 'Python, Blender, TensorFlow, YoloV5',
    description:
      'Built a synthetic data generation pipeline producing 30,000+ labeled training images for underwater object detection. Automated stereo image processing for 90% throughput improvement. Implemented conic reconstruction algorithms from published research.',
  },
  {
    title: 'OSU Underwater Robotics: ML Perception System',
    stack: 'Unity, C#, Python, Machine Learning',
    description:
      'Built a real-time Unity simulation for visualizing robot navigation behavior. Applied ML techniques to auto-label thousands of data points for distance and rotation detection in low-visibility water.',
  },
  {
    title: 'SUMO: Multiplayer Game',
    stack: 'Unity, C#, Steamworks, FishNetworking',
    description:
      'Shipped a multiplayer fighting game to Steam. Built real-time networking from scratch including lobby systems, state synchronization, and latency management.',
  },
  {
    title: 'Saucer',
    stack: 'TypeScript, React, Node.js, LLM, PostgreSQL',
    description:
      'Full-stack recipe organization app. Integrated LLMs for recipe parsing and generation. Built with React frontend, Node.js backend, and PostgreSQL database. Lives in a VPS for 24/7 availability'  ,
  },
];

const workExperience = [
  {
    title: 'Boeing',
    position: 'Software Engineer IC2',
    meta: 'Florida | 2024–Present',
    bullets: [
      'Developed automated integration tests validating vehicle software against real sensor data.',
      'Designed automation tools that cut rework by 50% and eliminated months of manual effort.',
      'Selected for multiple high-priority cross-functional teams across subsystems and infrastructure.',
    ],
  },
  {
    title: 'Nauticus Robotics',
    position: 'Software Engineer',
    meta: 'Houston, TX | 2022',
    bullets: [
      'Built a Blender-based synthetic data pipeline generating 30,000+ labeled ML training images.',
      'Automated stereo image processing pipeline, improving throughput by 90%.',
      'Implemented conic reconstruction algorithms from research papers for real-world computer vision deployment.',
    ],
  },
  {
    title: 'OSU Underwater Robotics',
    position: 'Autonomy & Perception Engineer',
    meta: 'Columbus, OH | 2020–2024',
    bullets: [
      'Built a Unity simulation for real-time visualization of robot navigation and perception.',
      'Applied ML techniques to auto-label thousands of data points for underwater object detection.',
    ],
  },
];
---

<BaseLayout
  title="Resume"
  description="Toby McGuire's resume - software engineer focused on AI, Autonomy, and Robotics."
>
  <section class="bg-surface-800 py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl border border-surface-200 bg-background-50 px-6 py-12 shadow-xl sm:px-10 lg:px-12">
        <div class="max-w-3xl mx-auto">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-10">
            <div>
              <h1 class="text-4xl font-bold text-text">Resume</h1>
              <p class="mt-2 text-text-600">
                Software Engineer - AI, Autonomy & Robotics
              </p>
            </div>
            <a
              href="/resume/Toby-McGuire-Resume.pdf"
              download
              class="inline-flex items-center px-5 py-2.5 rounded-lg bg-accent text-white font-medium hover:bg-accent-700 transition-colors text-sm self-start"
            >
              Download PDF
            </a>
          </div>

          <div class="space-y-12">
            <div>
              <h2 class="text-2xl font-bold text-text mb-4">Skills</h2>
              <div class="grid sm:grid-cols-2 gap-6">
                {
                  skillSections.map((section) => (
                    <div>
                      <h3 class="font-semibold text-text-800 mb-2">
                        {section.title}
                      </h3>
                      <div class="flex flex-wrap gap-2">
                        {section.items.map((item) => (
                          <span class="px-3 py-1 text-sm border border-accent-400 hover:border-accent-700 bg-background-50 hover:bg-background-100 text-text-800 rounded-full">
                            {item}
                          </span>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>

            <div>
              <h2 class="text-2xl font-bold text-text mb-4">
                Key Projects
              </h2>
              <div class="space-y-6">
                {
                  keyProjects.map((project) => (
                    <div class="border-l-2 border-accent-100 pl-4">
                      <h3 class="font-semibold text-text-900">{project.title}</h3>
                      <p class="text-sm text-text-600">Stack: {project.stack}</p>
                      <p class="mt-1 text-text-700 text-sm">
                        {project.description}
                      </p>
                    </div>
                  ))
                }
              </div>
            </div>

            <div>
              <h2 class="text-2xl font-bold text-text mb-4">
                Work Experience
              </h2>
              <div class="space-y-6">
                {
                  workExperience.map((role) => (
                    <div class="border border-text-200 rounded-xl p-5 bg-background-50">
                      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                        <div class="flex flex-col sm:flex-row sm:items-center gap-1 justify-center">
                           <h3 class="font-semibold text-text-900">{role.title}</h3>
                           <h4 class="text-xs italic text-text-700">{role.position}</h4>
                        </div>
                         <p class="text-sm text-text-600">{role.meta}</p>
                      </div>
                      <ul class="mt-3 space-y-2 text-sm text-text-700 list-disc pl-5">
                        {role.bullets.map((bullet) => (
                          <li>{bullet}</li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="bg-background-100 rounded-xl p-6 text-center">
              <p class="text-text-700">
                For full education details and a printable version, download the
                complete resume.
              </p>
              <a
                href="/resume/Toby-McGuire-Resume.pdf"
                download
                class="inline-flex items-center mt-3 px-5 py-2.5 rounded-lg bg-accent text-white font-medium hover:bg-accent-700 transition-colors text-sm"
              >
                Download PDF Resume
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
