---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout title="Contact" description="Get in touch with me.">
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-text">Contact</h1>
      <p class="mt-3 text-lg text-text-600">
        Have a question or want to work together? Reach out below.
      </p>

      <div class="mt-10 grid md:grid-cols-5 gap-10">
        <form
          action="https://formspree.io/f/meepyrne"
          method="POST"
          class="md:col-span-3 space-y-5"
        >
          <div>
            <label
              for="name"
              class="block text-sm font-medium text-text-800 mb-1">Name</label
            >
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-text-300 bg-background-50 text-text focus:ring-2 focus:ring-accent-500 focus:border-accent-500 outline-none transition-colors"
            />
          </div>
          <div>
            <label
              for="email"
              class="block text-sm font-medium text-text-800 mb-1">Email</label
            >
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-text-300 bg-background-50 text-text focus:ring-2 focus:ring-accent-500 focus:border-accent-500 outline-none transition-colors"
            />
          </div>
          <div>
            <label
              for="message"
               class="block text-sm font-medium text-text-800 mb-1"
              >Message</label
            >
            <textarea
              id="message"
              name="message"
              rows="5"
              required
               class="w-full px-4 py-2.5 rounded-lg border border-text-300 bg-background-50 text-text focus:ring-2 focus:ring-accent-500 focus:border-accent-500 outline-none transition-colors resize-y"
            ></textarea>
          </div>
          <button
            type="submit"
            class="inline-flex items-center px-6 py-3 rounded-lg bg-accent text-white font-medium hover:bg-accent-700 transition-colors"
          >
            Send Message
          </button>
          <p class="text-xs text-text-500">
            Form not working? Email me directly at <a
              href={`mailto:${siteConfig.email}`}
              class="text-accent hover:underline">{siteConfig.email}</a
            >.
          </p>
        </form>

        <div class="md:col-span-2 space-y-6">
          <div>
            <h2
              class="text-sm font-semibold text-text uppercase tracking-wide"
            >
              Email
            </h2>
            <a
              href={`mailto:${siteConfig.email}`}
              class="mt-1 text-accent hover:underline block"
              >{siteConfig.email}</a
            >
          </div>
          <div>
            <h2
              class="text-sm font-semibold text-text uppercase tracking-wide"
            >
              Profiles
            </h2>
            <ul class="mt-2 space-y-2">
              {
                siteConfig.social.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={
                        link.href.startsWith('mailto') ? undefined : '_blank'
                      }
                      rel={
                        link.href.startsWith('mailto')
                          ? undefined
                          : 'noopener noreferrer'
                      }
                      class="text-text-700 hover:text-accent transition-colors text-sm"
                    >
                      {link.label} &rarr;
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
