---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
import { homeContent } from '../data/home';
const { photos } = homeContent;
---

<BaseLayout
  title="About"
  description="About Toby McGuire - software engineer focused on AI, 
  autonomy, and robotics."
>
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-surface-900">
        <img
          src={photos.icon}
          alt="Toby McGuire profile photo"
          class="inline-block w-12 h-12 mr-2 rounded-full object-cover"
        />
        About Me
      </h1>
      <div class="mt-8 space-y-6 text-surface-600 leading-relaxed">
        <p class="text-lg">
          I'm Toby McGuire, a software engineer with an interest in AI, autonomy,
          and robotics. My career started in underwater robotics where I built
          ML pipelines for object detection in low-visibility environments. This 
          has since automated testing and integrated systems engineering at Boeing. 
          I'm drawn to work where software has a physical consequence, and I can learn
          a lot along the way.
        </p>

        <p>
          On the ML side, I've built synthetic data generation pipelines,
          automated stereo image processing workflows, and implemented
          research paper algorithms in real deployment environments. On the
          systems side, I've worked across large C++ codebases,
          cross-functional hardware-adjacent teams, and validation frameworks
          that touch real sensor data. I'm currently building out my full stack
          skills through projects like Saucer, a TypeScript/React/Node.js
          app, using AWS for authentication and cloud storage.
        </p>

        <p>
          Outside of engineering, I make games. I've shipped multiple titles
          on Steam and itch.io, run two marathons, and skied all over the
          western US and Whistler. I also have two cats, Fern (Black) and Faun (Calico).
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-4 float-center align-middle place-items-center">
        <img
          src={photos.marathon}
          alt="Toby running a marathon"
          class="w-full aspect-[4/3] object-cover rounded-lg"
        />
        <img
          src={photos.vab}
          alt="Toby at the Vehicle Assembly Building"
          class="w-full aspect-[4/4] object-cover rounded-lg"
        />
        <img
          src={photos.cats}
          alt="Toby's cats"
          class="w-full aspect-[4/3] object-cover rounded-lg"
        />
      </div>

      <div class="mt-12 flex flex-wrap gap-4">
        <a
          href={siteConfig.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-5 py-2.5 rounded-lg border border-surface-300 text-surface-700 font-medium hover:bg-surface-100 transition-colors text-sm"
        >
          GitHub
        </a>
        <a
          href={siteConfig.itch}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-5 py-2.5 rounded-lg border border-surface-300 text-surface-700 font-medium hover:bg-surface-100 transition-colors text-sm"
        >
          itch.io
        </a>
        <a
          href="/contact"
          class="inline-flex items-center px-5 py-2.5 rounded-lg bg-primary-600 text-white font-medium hover:bg-primary-700 transition-colors text-sm"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
